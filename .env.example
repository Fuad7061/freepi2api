# FreePi Bridge & Account Pool Manager Configuration

PORT=8787
HOST=0.0.0.0

# Optional: Require an API key when clients call /v1/chat/completions or /v1/models
BRIDGE_API_KEY=

# Optional: Protect the Dashboard /api/ endpoints with a password
ADMIN_PASSWORD=

# FreePi Upstream URL (default https://api.freepi.ai)
FREEPI_BASE_URL=https://api.freepi.ai

# Automated Ad Keepalive for free-tier accounts in pool (1 = enabled, 0 = disabled)
AUTO_AD=1
AD_INTERVAL_SECS=300

# Storage Protection: Delete logs older than this many days (default: 10 days)
LOG_RETENTION_DAYS=10
